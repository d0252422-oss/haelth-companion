{
  "schema_version": "ios-shortcut-tester.v1",
  "name": "健康資料同步",
  "environment": "beta",
  "project_ref": "uavimjgccigpbwqmfkhh",
  "ingestion_base_url": "https://uavimjgccigpbwqmfkhh.supabase.co/functions/v1/mobile-health-beta",
  "session_exchange_path": "/v1/connectors/ios-shortcut/session",
  "ingestion_path": "/v1/connectors/ios-shortcut/ingest",
  "ingestion_schema": "hdl-v2.connector-ingestion.v1",
  "authentication": "short_lived_single_use_beta_setup_code_then_24h_user_scoped_revocable_session",
  "session_request": { "environment": "beta", "claim": "ONE_TIME_CODE" },
  "ingestion_auth_headers": ["Authorization: Bearer <session access token>", "x-shortcut-session-id: <session id>"],
  "provider": "apple_health",
  "connector_type": "ios_shortcut",
  "read_only_domains": ["steps", "heart_rate", "resting_heart_rate", "sleep", "sleep_stage", "weight", "workout", "hrv", "spo2"],
  "max_records_per_batch": 250,
  "build_spec": {
    "version": "ios-shortcut-five-window.v1",
    "status": "OFFLINE_SPEC_ONLY_NOT_IMPORTABLE_SHORTCUT",
    "clock_policy": "ONE_FROZEN_UTC_END_ELAPSED_SECONDS",
    "point_boundary": "START_INCLUSIVE_END_EXCLUSIVE",
    "interval_boundary": "OVERLAP_PRESERVE_ORIGINAL_INTERVAL",
    "selected_domains": [
      { "domain": "steps", "lookback_seconds": 86400, "unit": "count", "selection": "POINT_RECORDED_AT" },
      { "domain": "heart_rate", "lookback_seconds": 86400, "unit": "bpm", "selection": "POINT_RECORDED_AT" },
      { "domain": "sleep", "lookback_seconds": 604800, "unit": "minute", "selection": "INTERVAL_OVERLAP" },
      { "domain": "weight", "lookback_seconds": 2592000, "unit": "kg", "selection": "POINT_RECORDED_AT" },
      { "domain": "workout", "lookback_seconds": 604800, "unit": "minute", "selection": "INTERVAL_OVERLAP" }
    ],
    "batch_policy": "DOMAIN_SEPARATE_MAX_250_STABLE_MEMBERSHIP_AND_SERIALIZED_PAYLOAD",
    "retry_policy": "BOUNDED_REPLAY_ORIGINAL_PAYLOAD_NO_NEW_IDENTITIES_OR_REVISIONS",
    "credentials": "RUNTIME_VARIABLES_ONLY_NEVER_SHARED_OR_LOGGED",
    "device_execution": "NOT_RUN",
    "server_window_enforcement": "NOT_IMPLEMENTED_BY_THIS_SPEC",
    "healthkit_shortcuts_field_availability": "NOT_DEVICE_VERIFIED"
  },
  "share_url": "",
  "runtime_status": "BACKEND_CONTRACT_PRESENT_ACTUAL_TARGET_NOT_REVALIDATED",
  "share_link_status": "BLOCKED_SHORTCUT_BUILD_DEVICE_AND_SHARE_LINK"
}
